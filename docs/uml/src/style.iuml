' Shared style for every diagram of opencode-coordination.
skinparam shadowing false
skinparam defaultFontName Helvetica
skinparam defaultFontSize 12
skinparam ArrowColor #444444
skinparam ArrowThickness 1.2
skinparam BackgroundColor white
skinparam ActorBorderColor #444444
skinparam ActorBackgroundColor #F4F4F4
skinparam ParticipantBorderColor #444444
skinparam ParticipantBackgroundColor #F7F7F7
skinparam DatabaseBorderColor #444444
skinparam DatabaseBackgroundColor #EEF3F8
skinparam SequenceLifeLineBorderColor #999999
skinparam SequenceGroupBorderColor #888888
skinparam SequenceGroupBackgroundColor #F0F0F0
skinparam NoteBackgroundColor #FFF8DC
skinparam NoteBorderColor #B8A86A
skinparam UsecaseBorderColor #444444
skinparam UsecaseBackgroundColor #F7F7F7
skinparam PackageBorderColor #777777
skinparam RectangleBorderColor #777777
skinparam ComponentBorderColor #444444
skinparam ComponentBackgroundColor #F7F7F7
skinparam ClassBorderColor #444444
skinparam ClassBackgroundColor #FAFAFA
skinparam StateBorderColor #444444
skinparam StateBackgroundColor #F7F7F7
skinparam ActivityBorderColor #444444
skinparam ActivityBackgroundColor #F7F7F7
skinparam ActivityDiamondBorderColor #444444
skinparam ActivityDiamondBackgroundColor #FFFFFF
skinparam sequenceMessageAlign center
skinparam maxMessageSize 260
skinparam wrapWidth 240
